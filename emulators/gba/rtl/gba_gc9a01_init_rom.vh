endfunction
function automatic [23:0] gc9a01_init_pause(input integer idx);
case (idx)
180: gc9a01_init_pause = (CLK_HZ / 1000) * 120;
181: gc9a01_init_pause = (CLK_HZ / 1000) * 20;
default: gc9a01_init_pause = 24'd0;
endcase
endfunction
