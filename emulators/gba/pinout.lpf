FREQUENCY NET "clk_core" 21.0 MHz;
FREQUENCY NET "clk_panel" 85.0 MHz;
FREQUENCY NET "clk_flash" 53.0 MHz;
FREQUENCY NET "clk_ram" 53.0 MHz;
LOCATE COMP "btn[0]" SITE "B4";
LOCATE COMP "btn[1]" SITE "A5";
LOCATE COMP "btn[2]" SITE "B5";
LOCATE COMP "btn[3]" SITE "A6";
LOCATE COMP "btn[4]" SITE "B6";
LOCATE COMP "btn_grey_n" SITE "D12";
LOCATE COMP "btn_red_n" SITE "C12";
IOBUF PORT "btn[*]" IO_TYPE=LVCMOS33 PULLMODE=UP;
IOBUF PORT "btn_grey_n" IO_TYPE=LVCMOS33 PULLMODE=UP;
IOBUF PORT "btn_red_n" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "led[0]" SITE "C3";
LOCATE COMP "led[1]" SITE "D3";
LOCATE COMP "led[2]" SITE "C4";
LOCATE COMP "led[3]" SITE "D4";
LOCATE COMP "led[4]" SITE "C5";
LOCATE COMP "led[5]" SITE "D5";
LOCATE COMP "led[6]" SITE "C6";
LOCATE COMP "led[7]" SITE "D6";
IOBUF PORT "led[*]" IO_TYPE=LVCMOS33;
LOCATE COMP "host_sck" SITE "A15";
LOCATE COMP "host_mosi" SITE "B15";
LOCATE COMP "host_miso" SITE "B16";
LOCATE COMP "host_cs_n" SITE "C15";
IOBUF PORT "host_sck" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
IOBUF PORT "host_mosi" IO_TYPE=LVCMOS33;
IOBUF PORT "host_miso" IO_TYPE=LVCMOS33;
IOBUF PORT "host_cs_n" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "pmod_j1[0]" SITE "A10"; # CE#
LOCATE COMP "pmod_j1[1]" SITE "A9";  # IO0
LOCATE COMP "pmod_j1[2]" SITE "A8";  # IO3
LOCATE COMP "pmod_j1[3]" SITE "A3";  # SCLK
LOCATE COMP "pmod_j1[4]" SITE "B10"; # IO1
LOCATE COMP "pmod_j1[5]" SITE "B9";  # IO2
IOBUF PORT "pmod_j1[*]" IO_TYPE=LVCMOS33;
IOBUF PORT "pmod_j1[4]" PULLMODE=UP;
IOBUF PORT "pmod_j1[5]" PULLMODE=UP;
IOBUF PORT "pmod_j1[2]" PULLMODE=UP;
LOCATE COMP "flash_cs_n" SITE "N8";
LOCATE COMP "flash_mosi" SITE "T8";
LOCATE COMP "flash_miso" SITE "T7";
IOBUF PORT "flash_cs_n" IO_TYPE=LVCMOS33;
IOBUF PORT "flash_mosi" IO_TYPE=LVCMOS33;
IOBUF PORT "flash_miso" IO_TYPE=LVCMOS33;
LOCATE COMP "oled_scl" SITE "C14";
LOCATE COMP "oled_sda" SITE "C13";
LOCATE COMP "oled_dc" SITE "E14";
LOCATE COMP "oled_cs" SITE "D14";
LOCATE COMP "oled_rst" SITE "D13";
IOBUF PORT "oled_scl" IO_TYPE=LVCMOS33;
IOBUF PORT "oled_sda" IO_TYPE=LVCMOS33;
IOBUF PORT "oled_dc" IO_TYPE=LVCMOS33;
IOBUF PORT "oled_cs" IO_TYPE=LVCMOS33;
IOBUF PORT "oled_rst" IO_TYPE=LVCMOS33;
LOCATE COMP "buzzer" SITE "F16";
IOBUF PORT "buzzer" IO_TYPE=LVCMOS33;

# FPGA configuration flash quad data inputs (board sd_io2/sd_io3 nets).
LOCATE COMP "flash_io2" SITE "M7";
LOCATE COMP "flash_io3" SITE "N7";
IOBUF PORT "flash_io2" IO_TYPE=LVCMOS33 PULLMODE=UP;
IOBUF PORT "flash_io3" IO_TYPE=LVCMOS33 PULLMODE=UP;
